{
  "name": "livelatex",
  "version": "0.1.0",
  "description": "Real-time LaTeX editor with live PDF preview",
  "main": "dist/main/index.js",
  "scripts": {
    "build:dev": "node scripts/build.mjs --dev",
    "build": "node scripts/build.mjs",
    "start": "npm run build:dev && electron .",
    "dev": "npm run build:dev && electron . --dev",
    "dist:portable": "npm run build && electron-builder --win portable --config electron-builder.yml",
    "dist:nsis": "npm run build && electron-builder --win nsis --config electron-builder.yml",
    "dist": "npm run build && electron-builder --win --config electron-builder.yml"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "7zip-bin": "^5.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "chokidar": "^3.6.0",
    "codemirror": "^6.0.1",
    "codemirror-lang-latex": "^0.4.2",
    "electron-store": "^8.2.0",
    "pdfjs-dist": "^4.8.0"
  }
}
